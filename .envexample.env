LITELLM_MASTER_KEY=sk-xxxxxxxx

# Web search — Tavily API (priority 1 engine, free tier: 1000 searches/month)
# Get your key at: https://tavily.com → Dashboard → API Keys
# Leave empty to skip Tavily and fall back to DuckDuckGo → Bing automatically
TAVILY_API_KEY=your_api_key_here
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_api_ID_here
DATABASE_URL=postgresql://llmuser:llmpassword@db:5432/litellm
CHROMA_HOST=chroma
CHROMA_PORT=xxxx
NVIDIA_API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_anthropic_key
MODEL_SOURCE=local
TRINITY_API_KEY=your_api_key_here
AGENT_MAX_ITERATIONS=25

# Email skill — fill in ONE provider block and leave the other commented out
EMAIL_PROVIDER=smtp
EMAIL_FROM=youremail@gmail.com

# SMTP (Gmail needs an App Password — not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=xxx
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=xxxx

# SendGrid (alternative — set EMAIL_PROVIDER=sendgrid to use)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# IMAP — for reading domain/local mail (gmail.imap_check_new, imap_list_inbox, etc.)
# Port 993 = SSL (recommended), 143 = plain IMAP
# IMAP_HOST=mail.yourdomain.com
# IMAP_PORT=993
# IMAP_USER=you@yourdomain.com
# IMAP_PASSWORD=your_password
# IMAP_SSL=true
OLLAMA_MODEL=qwen3.5:9b
# Enable Qwen3.5 extended thinking for better multi-step reasoning.
# Thinking produces richer reasoning chains at the cost of slower responses.
OLLAMA_THINK=true
OLLAMA_NUM_PREDICT=-1
# Timeout for vision analysis (analyze_design_folder). Qwen3.5 image analysis
# can take 3-5 min depending on image count and GPU speed. Default 300s.
WEB_BUILDER_TIMEOUT=600
